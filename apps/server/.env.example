# Live Draw Sync - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED VARIABLES
# =============================================================================

# PostgreSQL database connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For Neon: Use the pooled connection string
DATABASE_URL="postgresql://livedraw:your_password@localhost:5432/livedraw"

# Clerk Authentication
# Get these from https://dashboard.clerk.com
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."

# For Vite frontend (same as CLERK_PUBLISHABLE_KEY)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."

# =============================================================================
# PRODUCTION VARIABLES (Cloudflare + Fly.io)
# =============================================================================

# CORS allowed origins (comma-separated) - your Cloudflare Pages domain
# Example: https://livedraw.pages.dev,https://livedraw.com
CORS_ORIGINS=""

# API URL for frontend (your Fly.io or backend URL)
# Example: https://livedraw-api.fly.dev
VITE_API_URL=""

# WebSocket URL (usually same as API URL)
VITE_WS_URL=""

# =============================================================================
# OPTIONAL VARIABLES
# =============================================================================

# Server configuration
NODE_ENV="development"
PORT="3000"
HOST="0.0.0.0"

# Logging
LOG_LEVEL="info"           # debug, info, warn, error
LOG_FORMAT="pretty"        # pretty (dev), json (production)

# =============================================================================
# OBSERVABILITY (OpenTelemetry / Honeycomb)
# =============================================================================

# Honeycomb (recommended - free tier available at honeycomb.io)
# Server-side: Uses standard OTEL env vars
OTEL_SERVICE_NAME="live-draw-server"
OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
OTEL_EXPORTER_OTLP_ENDPOINT="https://api.honeycomb.io"
OTEL_EXPORTER_OTLP_HEADERS="x-honeycomb-team=your-api-key"

# Client-side: Uses VITE_ prefixed vars for browser tracing
VITE_HONEYCOMB_API_KEY="your-api-key"
VITE_OTEL_SERVICE_NAME="live-draw-client"

# Alternative: Raw OTLP config (for other backends like Grafana, Jaeger)
# OTEL_EXPORTER_OTLP_ENDPOINT="https://your-otlp-endpoint"
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer token"
# VITE_OTEL_EXPORTER_OTLP_ENDPOINT="https://your-otlp-endpoint"
