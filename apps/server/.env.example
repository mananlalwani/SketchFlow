# Required in all environments: PostgreSQL connection string for Prisma.
DATABASE_URL=postgresql://sketchflow:change-me@localhost:5432/sketchflow

# Required in all environments. Use a Clerk secret key; production requires an sk_live_ key.
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key

# Required in production: comma-separated trusted browser origins, with no paths.
CORS_ORIGINS=http://localhost:5173

# Server binding.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Optional deployment settings.
# CLIENT_URL=https://app.example.com
# REDIS_URL=redis://localhost:6379
# RELEASE_ID=git-sha-or-release-number
# SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# Keep SENTRY_AUTH_TOKEN, SENTRY_ORG, and SENTRY_PROJECT in deployment-only secret storage.
# LOG_LEVEL=info
# LOG_FORMAT=json
