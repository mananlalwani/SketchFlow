# Public Clerk key used by the Vite client. This value is intentionally safe to expose.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key

# Browser OpenTelemetry export is intentionally disabled until SketchFlow has a
# controlled same-origin collector. Never add API keys or authorization headers to VITE_ variables.
# VITE_RELEASE_ID=git-sha-or-release-number

# Sentry DSNs are public ingest identifiers; never put SENTRY_AUTH_TOKEN in a VITE_ variable.
# VITE_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
# VITE_SENTRY_ENVIRONMENT=production

# Optional: custom key for .dra file format encryption (defaults to a public constant)
# VITE_DRAW_FORMAT_KEY=your-custom-key-here
