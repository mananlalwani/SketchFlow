{
  "name": "live-draw-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Live drawing canvas that syncs between iPad drawer and PC viewer using Socket.IO",
  "main": "server.js",
  "scripts": {
    "start": "node --max-old-space-size=512 server.js",
    "dev": "NODE_ENV=development node --inspect --max-old-space-size=512 server.js",
    "prod": "NODE_ENV=production node --max-old-space-size=1024 server.js"
  },
  "keywords": [
    "drawing",
    "socket.io",
    "express",
    "live",
    "sync"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  }
}



