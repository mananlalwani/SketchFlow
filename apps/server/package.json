{
  "name": "@sketchflow/server",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=512' tsx watch -r dotenv/config src/index.ts",
    "build": "tsc",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:integration": "RUN_REAL_INFRASTRUCTURE=1 vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@clerk/express": "^2.1.81",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/propagator-jaeger": "^2.12.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/node": "^11.8.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "redis": "^6.3.0",
    "socket.io": "^4.8.4",
    "yargs": "^18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@sketchflow/shared": "workspace:*",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.9.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.4",
    "tsx": "^4.6.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "8.43.0",
    "vitest": "^4.1.10"
  }
}
